# 데이터베이스 구성(Database Configuration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arxiv_papers
DB_USER=postgres
DB_PASSWORD=your_password

# ArXiv 구성(ArXiv Configuration)
ARXIV_MAX_RESULTS=100
ARXIV_RATE_LIMIT=3 # 요청 사이의 간격(초)

# 모델 구성(Model Configuration)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu # GPU를 사용할 수 있는 경우 'cuda'

# 스토리지 구성(Storage Configuration)
PDF_STORAGE_PATH=./data/pdfs
CACHE_PATH=./data/cache
LOG_PATH=./data/logs
